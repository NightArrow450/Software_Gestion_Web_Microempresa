# Solo para pruebas: nunca utilizar la base de trabajo ni credenciales de producción.
MYSQL_TEST_ENABLE=1
MYSQL_TEST_HOST=127.0.0.1
MYSQL_TEST_PORT=3306
MYSQL_TEST_DATABASE=dhacer_eco_limp_test_concurrencia
MYSQL_TEST_USERNAME=usuario_de_pruebas
MYSQL_TEST_PASSWORD=
# Exportar estas variables en la terminal; este archivo no se carga automáticamente.
# Ejecutar: vendor/bin/phpunit --configuration=phpunit.mysql.xml --group=mysql-concurrencia
# El usuario de pruebas necesita crear la base aislada y consultar performance_schema.
