# Referencia: introducir individualmente en App Service > Environment variables.
# No copiar al .env local. Nunca guardar aquí valores reales.
APP_NAME="DHACER ECO LIMP"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://REEMPLAZAR.azurewebsites.net
APP_KEY=REEMPLAZAR_POR_CLAVE_GENERADA_UNA_SOLA_VEZ
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Lima
DB_CONNECTION=mysql
DB_HOST=REEMPLAZAR.mysql.database.azure.com
DB_PORT=3306
DB_DATABASE=dhacer_tesis
DB_USERNAME=REEMPLAZAR
DB_PASSWORD=REEMPLAZAR_EN_PORTAL
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
SESSION_DRIVER=database
SESSION_COOKIE=dhacer_azure_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=local
LARAVEL_STORAGE_PATH=/home/dhacer-storage
LOG_CHANNEL=stack
LOG_STACK=stderr,seguridad
LOG_LEVEL=warning
DEMO_ACTIVA=false
PROXY_MODE=standard
TRUSTED_PROXIES=
SCM_DO_BUILD_DURING_DEPLOYMENT=false
WEBSITES_ENABLE_APP_SERVICE_STORAGE=true
# Solo mientras se inicializa el administrador; luego eliminar estas dos variables.
ADMIN_EMAIL=REEMPLAZAR
ADMIN_PASSWORD=REEMPLAZAR_EN_PORTAL
